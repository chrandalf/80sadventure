{
  "_readme": "THE SPRITE CONTRACT. Game code never names a PNG - it asks for a logical id below. To replace any sprite, drop a PNG with the declared dimensions next to this file and run `npm run assets:validate`. To change a sprite's size or frame layout, edit its entry here; that is the only place geometry is defined. Missing files are not an error: the loader generates a correctly-sized, palette-correct placeholder so the game always runs. Full instructions in docs/ASSETS.md.",

  "templates": {
    "person": {
      "frameWidth": 24,
      "frameHeight": 40,
      "columns": 6,
      "rows": 4,
      "anchorX": 12,
      "anchorY": 40,
      "_layout": "Row 0 = facing camera, row 1 = facing right, row 2 = facing away, row 3 = expressions. Left-facing is the right-facing row mirrored automatically, so you never draw it. Columns 0-3 of rows 0-2 are the walk cycle (col 0 doubles as the standing pose); columns 4-5 are the two-frame talk loop.",
      "animations": {
        "idle": { "frames": [0], "fps": 0, "loop": false },
        "idle.south": { "frames": [0], "fps": 0, "loop": false },
        "walk.south": { "frames": [0, 1, 2, 3], "fps": 8 },
        "talk.south": { "frames": [4, 5], "fps": 6 },
        "idle.east": { "frames": [6], "fps": 0, "loop": false },
        "walk.east": { "frames": [6, 7, 8, 9], "fps": 8 },
        "talk.east": { "frames": [10, 11], "fps": 6 },
        "idle.north": { "frames": [12], "fps": 0, "loop": false },
        "walk.north": { "frames": [12, 13, 14, 15], "fps": 8 },
        "talk.north": { "frames": [16, 17], "fps": 6 },
        "surprised": { "frames": [18], "fps": 0, "loop": false },
        "annoyed": { "frames": [19], "fps": 0, "loop": false },
        "happy": { "frames": [20], "fps": 0, "loop": false },
        "frightened": { "frames": [21], "fps": 0, "loop": false },
        "worried": { "frames": [22], "fps": 0, "loop": false },
        "smug": { "frames": [23], "fps": 0, "loop": false }
      }
    },

    "icon": {
      "frameWidth": 16,
      "frameHeight": 16,
      "columns": 1,
      "rows": 1,
      "anchorX": 8,
      "anchorY": 16,
      "_layout": "A single 16x16 inventory icon. Keep one pixel of padding all round so it does not touch the slot border.",
      "animations": { "idle": { "frames": [0], "fps": 0, "loop": false } }
    },

    "prop": {
      "frameWidth": 32,
      "frameHeight": 32,
      "columns": 2,
      "rows": 1,
      "anchorX": 16,
      "anchorY": 32,
      "_layout": "Two frames: 0 = resting, 1 = active/alternate. Anchored at the bottom centre so it sits on the floor.",
      "animations": {
        "idle": { "frames": [0], "fps": 0, "loop": false },
        "active": { "frames": [0, 1], "fps": 4 }
      }
    }
  },

  "sprites": {
    "char.jack": {
      "template": "person",
      "file": "jack.png",
      "description": "Jack Mercer, 20. Trainee arcade technician. Cheap dark jacket, band t-shirt, jeans, terrible 1987 hair. Perpetually unimpressed.",
      "placeholder": { "kind": "humanoid", "primary": "#2050c8", "secondary": "#33244d", "label": "Jack" }
    },
    "char.maggie": {
      "template": "person",
      "file": "maggie.png",
      "description": "Maggie Vale, 19. Works the arcade. Practical, guarded. Denim jacket, dark red top. Never drawn as a prize - she stands like someone who knows more than you.",
      "placeholder": { "kind": "humanoid", "primary": "#c4142e", "secondary": "#4a0f3a", "label": "Maggie" }
    },
    "char.arthur": {
      "template": "person",
      "file": "arthur.png",
      "description": "Arthur Bell, 57. Arcade owner. Enormous moustache, permanent mustard cardigan, shirt and tie underneath. Slightly stooped.",
      "placeholder": { "kind": "humanoid", "primary": "#a8560c", "secondary": "#4a2408", "label": "Arthur" }
    },
    "char.derek": {
      "template": "person",
