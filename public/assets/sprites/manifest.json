    },
    "char.drvale": {
      "template": "person",
      "file": "drvale.png",
      "description": "Dr Elliot Vale. White shirt, dark trousers, black tie. Row 3 holds his three states: silhouette (18), normal (19), distorted/scanline-torn (20). His face must not be legible until frame 19 is used.",
      "placeholder": { "kind": "humanoid", "primary": "#d8d4e8", "secondary": "#0a0713", "label": "Vale" }
    },
    "char.guest": {
      "template": "person",
      "file": "guest.png",
      "description": "Hotel guest for the Room 12 gag (s.47). Adult male in a towel and nothing else - drawn strictly from the waist up in silhouette against the bathroom light, per s.56. Comedy is the timing, not the anatomy.",
      "placeholder": { "kind": "humanoid", "primary": "#d8d4e8", "secondary": "#8f86a8", "label": "Guest" }
    },
    "char.cabin": {
      "template": "person",
      "file": "cabin.png",
      "description": "Changing-cabin occupant (s.48). Adult woman, seen for a single frame before the hard cut, drawn as a flat silhouette behind a half-drawn curtain. Never rendered in detail.",
