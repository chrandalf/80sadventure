{
  "_readme": "OBJECT + INVENTORY SPRITE CONTRACT. Same rules as the character manifest: logical ids, declared geometry, drop-in replacement. 'item.*' are inventory icons; 'prop.*' are scene objects that depth-sort against characters.",
  "templates": {
    "icon": {
      "frameWidth": 16,
      "frameHeight": 16,
      "columns": 1,
      "rows": 1,
      "anchorX": 8,
      "anchorY": 16,
      "_layout": "A single 16x16 inventory icon. Keep one pixel of padding all round so it does not touch the slot border.",
      "animations": {
        "idle": {
          "frames": [
            0
          ],
          "fps": 0,
          "loop": false
        }
      },
      "renderScale": 2,
      "_renderScale": "Sheet is cut in the legacy 320x200 space, so it is drawn at 2x on the 640x400 screen. Art authored natively at 640x400 should set renderScale to 1 and double its frameWidth/frameHeight instead."
    },
    "prop": {
      "frameWidth": 32,
      "frameHeight": 32,
      "columns": 2,
      "rows": 1,
      "anchorX": 16,
      "anchorY": 32,
      "_layout": "Two frames: 0 = resting, 1 = active/alternate. Anchored at the bottom centre so it sits on the floor.",
      "animations": {
        "idle": {
          "frames": [
            0
          ],
          "fps": 0,
          "loop": false
        },
        "active": {
          "frames": [
            0,
            1
          ],
          "fps": 4
        }
      },
      "renderScale": 2,
      "_renderScale": "Sheet is cut in the legacy 320x200 space, so it is drawn at 2x on the 640x400 screen. Art authored natively at 640x400 should set renderScale to 1 and double its frameWidth/frameHeight instead."
    }
  },
