{
  "name": "one-more-credit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One More Credit - an 80s point-and-click adventure",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets:placeholders": "node tools/gen-placeholders.mjs",
    "assets:validate": "node tools/validate-assets.mjs",
    "assets:quantize": "node tools/quantize.mjs",
    "assets:palette": "node tools/make-palette-image.mjs",
    "assets:manifest": "esbuild tools/gen-assets-manifest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/gen-assets.mjs --log-level=error && node node_modules/.cache/gen-assets.mjs",
    "assets:batch": "node tools/gen-openai-batch.mjs",
    "assets:generate": "node tools/run-openai-images.mjs",
    "assets:ingest": "node tools/ingest-assets.mjs"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
